---
import Carousel from '../components/Carousel.svelte';
import { getLangFromURL } from "../i18n/helpers";
import SectionTitle from "./SectionTitle.svelte";
import {slides} from '../constants'

const language = getLangFromURL(Astro.url)
---

<section class="min-h-screen bg-transparent p-8 flex flex-col items-center md:mt-80" id="projects" aria-label="projects-section">

<SectionTitle client:visible direction="left" title='projects.title'  language={language} />

<Carousel client:visible images={slides} autoSlide={true} />

</section>