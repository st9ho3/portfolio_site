---
import { Icon } from 'astro-icon/components';
import Navbar from './Navbar.astro';
import Link from './Link.astro';
import {navBarPaths} from '../constants.ts'
---

<header class="flex fixed top-0 z-10 mb-5 items-center justify-between w-full px-8 ">
    <Link name="home-icon" href="/">
        <Icon name='astro' width={50} height={80} class="w-12 md:w-16 h-20 transition-transform hover:scale-105 duration-300" />
    </Link>
    <Navbar items={navBarPaths}/>
</header>