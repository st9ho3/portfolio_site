---
import TypedAnimation from './TypedAnimation.astro'
import Actions from './Actions.astro'
import {taglines, heroGreeting} from '../constants'
---

<section class="flex relative justify-center" id="hero" aria-label="hero section">
  <div class="flex flex-col justify-center relative mt-30 p-6">
    <div>
      <h1 class="my-2 text-5xl text-white md:text-8xl">{heroGreeting}</h1>
      <TypedAnimation id="tagline" stringProps={taglines} speed=9.5 />
    </div>
    <Actions />

  </div>
</section>