---
const {href, name, line} = Astro.props
---

<a aria-label="nav-ink" class="group relative cursor-pointer text-lg hover:text-white text-gray-400 transition-all duration-400" aria-label={name} href={href}>
    <slot/>
    <div class=`absolute ${!line && 'hidden'} border top-8 border-black w-0 group-hover:w-full group-hover:border-white transition-all duration-500`>
    </div>
</a>

