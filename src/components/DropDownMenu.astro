---
import type { PathOptions } from '../constants'
import { getLangFromURL, useTranslation } from '../i18n/helpers'
import LangOption from './LangOption.astro'

interface Props {
  type?: string
  items: PathOptions[]
}

const { items, type } = Astro.props
const language = getLangFromURL(Astro.url)
const t = useTranslation(language)
const currentPath = Astro.url.pathname 

---

<div
  class={`dropdown-menu hidden absolute rounded-lg md:right-6 md:p-4 border border-white opacity-90 bg-black ${
    type === 'nav' ? 'flex-col top-10 right-0 items-center w-80 h-100' : 'w-30'}`}>
  {
    type === 'nav'
      ?<div class="px-4">
        {items.map((item) => (
          <p onclick="" class="dropdown-element text-white my-10 text-3xl hover:text-gray-500 transition-colors duration-300">
            <a href={item.path}>{item.name ? t(item.name) : '' }</a>
          </p>
        ))}
      </div>
      <LangOption />
      : items.map((item) => (
          <p class="text-white font-bold text-2xl hover:bg-gray-800 rounded-lg duration-300">
            {currentPath !== item.path ? (
              <a href={item.path}>{ item.lang }</a>
            ) : (
              <span class="cursor-pointer">{item.lang}</span>
            )}
          </p>
        ))
  }
</div>