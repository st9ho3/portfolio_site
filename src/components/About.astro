---
import TypedAnimation from "./TypedAnimation.astro";
import { getLangFromURL } from "../i18n/helpers";
import {getData} from "../lib"
import SectionTitle from "./SectionTitle.svelte";

const language = getLangFromURL(Astro.url)
const {href} = new URL(`/api/${language}/profileInfo`, Astro.url)
const requestUrl = `${href}`
const {aboutText} = await getData(requestUrl)

---

<section class="md:mt-150 justify-center p-5" id="aboutme">
<SectionTitle client:visible language={language} title='about.title' direction="right" />
<div class="h-90">
    <TypedAnimation id="about" stringProps={aboutText} speed=9 />
</div>

</section>

