---
import { getText } from "../lib"
const {id, stringProps, speed} = Astro.props
---

<span id={id} class={getText(id)} aria-labale="animated-text"> </span>

<script src="https://unpkg.com/typed.js@2.1.0/dist/typed.umd.js"></script>

  <script define:vars={{ id, stringProps, speed }}>
    document.addEventListener('DOMContentLoaded', () => {
      // @ts-ignore
      if (window.Typed) {
        // @ts-ignore
        new window.Typed(`#${id}`, {
          strings: stringProps,
          typeSpeed: speed,
          backSpeed: 30,
          smartBackspace: true,
          loop: true,
          cursorChar: '⼁'
        });
      }
    });
  </script>